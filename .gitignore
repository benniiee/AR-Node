# ---------------------------------------------------------------- dependencies (reinstall: composer install, npm ci)
/vendor
/node_modules
/resources/admin/node_modules

# ---------------------------------------------------------------- build output (rebuilt by npm run build)
/public/build
/public/admin
/public/hot
/public/storage
# Generated by vite.config.js from resources/pwa/service-worker.js on every build.
/public/sw.js

# ---------------------------------------------------------------- secrets and local environment (never commit)
.env
.env.backup
.env.*
!.env.example
/storage/*.key
auth.json
Homestead.json
Homestead.yaml

# ---------------------------------------------------------------- tools and caches
/.phpunit.cache
.phpunit.result.cache
npm-debug.log
yarn-error.log
*.log
# PMTiles command-line tool (59 MB binary): download it from github.com/protomaps/go-pmtiles/releases
/pmtiles.exe
# Personal editor / assistant settings (the shared .claude/settings.json and skills stay)
/.fleet
/.idea
/.vscode
/.zed
/.nova
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- Python (ml/)
venv/
.venv/
env/
__pycache__/
*.pyc

# ---------------------------------------------------------------- ml/: downloaded data and personal run files
# Downloaded history (about 61 MB; rebuilt by the GUI's download buttons: Open-Meteo, METAR,
# 9 forecast models, satellite, heat). The trained models (ml/*.json) and their evaluation
# reports (ml/reports/metrics*.json, results*.csv, calibration*.png, heat_metrics.json) ARE committed.
/ml/data/
# Backups of older models and data made before retraining
/ml/reports/before-*/
# Logs and live test runs from this PC (the GUI's buttons, "It's raining / dry" answers)
/ml/reports/last_*_log.txt
/ml/reports/live_*.csv
/ml/reports/live_*.jsonl
/ml/reports/heat_live_predictions.csv
/ml/reports/rain_observations.csv
/ml/reports/satellite_comparison*.json
