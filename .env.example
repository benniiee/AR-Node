APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8005

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser origins allowed to send stateful (cookie) auth. These are frontend
# origins, not just the API host — keep them in sync with the Vite port in
# vite.config.js / package.json, or Sanctum silently falls back to token auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,localhost:5174,localhost:8005,127.0.0.1,127.0.0.1:5173,127.0.0.1:8005,::1

# Empty = same-origin (Vite proxies /api to the backend, like the admin page).
# Only set a LAN URL here for the future HTTPS setup where the PWA is
# served from a different origin than the API (spec section 6).
VITE_API_BASE_URL=

# ── Weather-aware routing ─────────────────────────────────────────────────
# One forecast point for the whole campus (default = the campus centre in
# src/campusMap.js). Open-Meteo free tier: no API key, non-commercial use,
# CC BY 4.0 — keep the "Weather data by Open-Meteo.com" credit visible.
WEATHER_LAT=6.913164
WEATHER_LNG=122.061753
# Cost multiplier applied to a fully exposed (outside -> outside) edge while
# rain mode is on. Entrances take half of it; sheltered edges are never
# penalised.
WEATHER_RAIN_PENALTY=2.0
# 'rain' / 'dry' force the state (demos, tests); empty = live forecast data.
WEATHER_FORCE=
